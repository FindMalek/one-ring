{
  "name": "onering",
  "version": "0.1.0",
  "description": "Cross-platform dotfiles manager and machine bootstrap CLI",
  "type": "module",
  "bin": {
    "onering": "./cli/index.ts"
  },
  "scripts": {
    "dev": "bun run cli/index.ts",
    "build": "bun build ./cli/index.ts --compile --outfile onering",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "dependencies": {
    "ink": "^5.1.0",
    "js-yaml": "^4.1.0",
    "react": "^18.3.1",
    "react-devtools-core": "^4.28.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.18",
    "bun": "^1.2.0",
    "typescript": "^5.7.3",
    "vitepress": "^1.6.3"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
