{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["bun-types"]
  },
  "include": ["cli/**/*.ts", "cli/**/*.tsx", "compilers/**/*.ts", "installers/**/*.ts", "modules/**/*.ts", "config/**/*.ts", "tests/**/*.ts"]
}
